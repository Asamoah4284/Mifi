{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.mola-wifi.online/api/:path*"
    },
    {
      "source": "/ussd/:path*",
      "destination": "https://api.mola-wifi.online/ussd/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
